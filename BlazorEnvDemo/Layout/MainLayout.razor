@inherits LayoutComponentBase
@inject IWebAssemblyHostEnvironment HostEnv
@inject IOptions<AppConfig> Config

<div class="page">

    <!-- Environment banner — color driven from appsettings, proves the right file was loaded -->
    <div class="env-banner" style="background-color: @Config.Value.BannerColor;">
        <span class="env-banner-icon">@GetEnvIcon()</span>
        <span>Active Client Environment: <strong>@HostEnv.Environment</strong></span>
        <span class="env-banner-label">(@Config.Value.EnvironmentLabel)</span>
    </div>

    <div class="sidebar">
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">BlazorEnvDemo</a>
            </div>
        </div>
        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />
        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="flex-column">
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <span aria-hidden="true">🏠</span> Home
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="proof">
                        <span aria-hidden="true">🔬</span> Findings Proof
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="traps">
                        <span aria-hidden="true">⚠️</span> Common Traps
                    </NavLink>
                </div>
            </nav>
        </div>
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/blazor/fundamentals/environments" target="_blank">
                Blazor Environments Docs ↗
            </a>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private string GetEnvIcon() => HostEnv.Environment.ToLowerInvariant() switch
    {
        "development" => "🛠",
        "uat"         => "🧪",
        "production"  => "🚀",
        _             => "❓"
    };
}
